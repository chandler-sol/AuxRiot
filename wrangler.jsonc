{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "auxriot",
	"account_id": "0bf986208f219b3ecd65ab7f23e49d8e",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"observability": { "enabled": true },
	"routes": [
		{ "pattern": "auxriot.com", "custom_domain": true },
		{ "pattern": "www.auxriot.com", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "auxriot",
			"database_id": "902827de-ab87-4f39-8ecb-eb5fba691a9f",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [{ "binding": "AUDIO", "bucket_name": "auxriot-audio" }],
	"vars": {
		"MIN_VOTER_ACCOUNT_AGE_HOURS": "168",
		"OPEN_BATTLE_EXPIRY_DAYS": "14",
		"ADMIN_USERNAMES": "ARSENiK",
		"TURNSTILE_SITE_KEY": ""
	}
}
